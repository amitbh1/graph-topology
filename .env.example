# =============================================================================
# MedGraph configuration. Copy to .env. Never commit .env.
# `python -m medgraph check-config` lists unsafe values; in production
# (MEDGRAPH_ENV=production) the API refuses to start while any exist.
# =============================================================================
MEDGRAPH_ENV=development

# --- Neo4j -------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medgraph-local            # CHANGE for production
NEO4J_DATABASE=neo4j
# Optional least-privilege account used by the API/assistant (Neo4j Enterprise RBAC).
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=
NEO4J_QUERY_TIMEOUT_S=15
NEO4J_POOL_SIZE=50

# --- Authentication & HTTP ---------------------------------------------------
# Comma-separated name:scopes:sha256 entries. Create with:
#   python -m medgraph apikey alice --scopes read,chat
# Scopes: read (graph endpoints), chat (assistant), admin (stats, metrics).
MEDGRAPH_API_KEYS=
# Development only — refused when MEDGRAPH_ENV=production.
MEDGRAPH_AUTH_DISABLED=false
CORS_ORIGINS=                            # e.g. https://medgraph.example.org (never * in production)
TRUSTED_PROXIES=                         # CIDRs whose X-Forwarded-For is trusted, e.g. 10.0.0.0/8
MAX_BODY_BYTES=65536
RATE_LIMIT_READ_PER_MIN=120              # per key + client IP
RATE_LIMIT_CHAT_PER_MIN=10
RATE_LIMIT_ANON_PER_MIN=30               # per IP: dev mode and failed-auth attempts
LOG_LEVEL=INFO
LOG_QUESTION_TEXT=false                  # questions may contain health data; logs keep a hash by default

# --- Embeddings --------------------------------------------------------------
# ollama -> local nomic-embed-text ; hash -> lexical offline fallback (tests/demos only)
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_BASE_URL=http://localhost:11434

# --- Assistant LLM -----------------------------------------------------------
# ollama -> local model with tool calling (e.g. qwen2.5:7b) ; openai -> OpenAI-compatible endpoint
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b
OPENAI_BASE_URL=http://localhost:4096/v1
OPENAI_API_KEY=not-needed-for-local
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1024

# --- Agent limits ------------------------------------------------------------
AGENT_DEADLINE_S=90                      # whole question, all tool calls included
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_CONCURRENCY=4                  # simultaneous assistant runs per process
TOOL_OUTPUT_MAX_CHARS=6000
ANSWER_MAX_CHARS=6000
QUESTION_MAX_CHARS=1000
HISTORY_MAX_TURNS=10
HISTORY_TURN_MAX_CHARS=4000
ENABLE_GRAPH_QA=true                     # LLM-generated (validated, read-only) Cypher
GRAPH_QA_MAX_ROWS=50

# --- ETL sizes ---------------------------------------------------------------
ETL_LABEL_LIMIT=250
ETL_FAERS_PER_DRUG=10
ETL_TRIALS_PER_CONDITION=20
ETL_TRIAL_CONDITIONS=40
ATC_CSV_URL=https://raw.githubusercontent.com/fabkury/atcd/master/WHO%20ATC-DDD%202026-04-25.csv
MESH_XML_URL=https://nlmpubs.nlm.nih.gov/projects/mesh/MESH_FILES/xmlmesh/desc2026.gz
