# =============================================================================
# EnergyGraph configuration. Copy to .env. Never commit .env.
# `python -m energygraph check-config` lists unsafe values; with
# ENERGYGRAPH_ENV=production the API refuses to start while any exist.
# =============================================================================
ENERGYGRAPH_ENV=development

# --- Neo4j -------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=energygraph-local         # CHANGE for production
NEO4J_DATABASE=neo4j
NEO4J_READ_USER=                         # optional least-privilege account (Neo4j Enterprise RBAC)
NEO4J_READ_PASSWORD=
NEO4J_QUERY_TIMEOUT_S=15
NEO4J_POOL_SIZE=50

# --- Time series (published prices) --------------------------------------------
TIMESERIES_URL=sqlite:///data/timeseries.sqlite3

# --- Authentication & authorisation ------------------------------------------
# API keys: name:scopes:entitlements:sha256 — create with:
#   python -m energygraph apikey analyst --scopes read,chat --entitlements public,org:power-assets
# scopes: read | chat | admin     entitlements: public | org:<dataset> | * (all data)
ENERGYGRAPH_API_KEYS=
# OIDC / SSO (optional). Tokens must carry a scope claim (read/chat/admin or energygraph:read ...)
# and an entitlements claim (list or space-separated).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_SCOPE_CLAIM=scope
OIDC_ENTITLEMENT_CLAIM=entitlements
# Development only — refused when ENERGYGRAPH_ENV=production.
ENERGYGRAPH_AUTH_DISABLED=false
DEV_ENTITLEMENTS=public                  # what the anonymous dev user may see when auth is disabled

CORS_ORIGINS=
TRUSTED_PROXIES=
MAX_BODY_BYTES=65536
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_CHAT_PER_MIN=10
RATE_LIMIT_ANON_PER_MIN=30
LOG_LEVEL=INFO
LOG_QUESTION_TEXT=false                  # client questions are confidential; logs keep a hash by default

# --- Embeddings ----------------------------------------------------------------
EMBEDDING_BACKEND=ollama                 # ollama | hash (lexical offline fallback, tests only)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_BASE_URL=http://localhost:11435

# --- Assistant LLM ---------------------------------------------------------------
LLM_BACKEND=ollama                       # ollama | openai (any OpenAI-compatible gateway)
LLM_MODEL=qwen2.5:7b
OPENAI_BASE_URL=http://localhost:4096/v1
OPENAI_API_KEY=not-needed-for-local
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1024

# --- Agent limits ----------------------------------------------------------------
AGENT_DEADLINE_S=90
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_CONCURRENCY=4
TOOL_OUTPUT_MAX_CHARS=6000
ANSWER_MAX_CHARS=6000
QUESTION_MAX_CHARS=1000
HISTORY_MAX_TURNS=10
HISTORY_TURN_MAX_CHARS=4000
ENABLE_GRAPH_QA=true                     # only ever runs for principals entitled to all data (*)
GRAPH_QA_MAX_ROWS=50

# --- Public sources ----------------------------------------------------------------
EIA_API_KEY=                             # free key: https://www.eia.gov/opendata/ (prices are skipped without it)
GPPD_MIN_MW=50
GLEIF_MAX_COMPANIES=300

# --- organization-source (masked; integrate later) -------------------------------------
# disabled | file (ORG_SOURCE_DIR/<dataset>.jsonl) | http (ORG_SOURCE_BASE_URL, https only)
ORG_SOURCE_MODE=disabled
ORG_SOURCE_DIR=
ORG_SOURCE_BASE_URL=
ORG_SOURCE_TOKEN=
ORG_SOURCE_TIMEOUT_S=30
